# Supabaseプロジェクトの設定 (Project Settings > API から取得)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 実験的な機能(スコアシート機能・ライブ記録画面の先行検証項目等)を有効にする
# team_idのカンマ区切り一覧(検証用)。未設定の場合、対象の機能は全チームで無効。
VITE_TEST_TEAM_IDS=

# 旧名(スコアシート機能導入時に設定したもの)。VITE_TEST_TEAM_IDSが未設定の場合のみ
# フォールバックとして参照される(src/lib/testTeamConfig.js参照)。新規設定は不要。
VITE_SCORE_SHEET_TEST_TEAM_IDS=
