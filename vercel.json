{
  "rewrites": [
    { "source": "/t/([^.]*)", "destination": "/invite.html" },
    { "source": "/((?!api/|assets/)[^.]*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/((?!og/).*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/contact-cleanup", "schedule": "0 18 * * *" }
  ]
}
